# Database Configuration (Neon PostgreSQL)
# Replace the placeholder credentials with your Neon PostgreSQL connection string
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://username:password@ep-placeholder.region.aws.neon.tech/lotus_school_db?sslmode=require"

# Server Configuration
PORT=5000
CLIENT_URL="http://localhost:3000"

# Authentication Security (Replace with a 64+ char random string in production)
JWT_SECRET="replace_with_a_long_random_secret"
