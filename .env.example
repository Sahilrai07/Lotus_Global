# Database Configuration (Neon PostgreSQL)
# Replace the placeholder credentials with your Neon PostgreSQL connection string
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://username:password@ep-placeholder.region.aws.neon.tech/lotus_school_db?sslmode=require"

# Server Configuration
PORT=5000
CLIENT_URL="http://localhost:3000"

# Authentication Security (Replace with a 64+ char random string in production)
JWT_SECRET="replace_with_a_long_random_secret"

# Email Notification Settings (Nodemailer / SMTP)
# To send inquiry notification emails to the school's official inbox, configure Gmail App Password or custom SMTP:
# How to get a Gmail App Password:
# 1. Enable 2-Step Verification on the Gmail account (lotusglobalschool@gmail.com)
# 2. Go to Google Account -> Security -> App passwords (https://myaccount.google.com/apppasswords)
# 3. Create an App password named "Lotus School Website" and paste the 16-character code into SMTP_PASS below
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="lotusglobalschool@gmail.com"
SMTP_PASS="your_gmail_app_password_here"
SCHOOL_OFFICIAL_EMAIL="lotusglobalschool@gmail.com"

